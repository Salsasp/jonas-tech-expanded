{
	code: "jonasworkbench",
	class: "BlockJonasWorkbench",
	entityClass: "JonasWorkbench",
	behaviors: [
		{ name: "HorizontalOrientable" },
		// Two blocks wide. The model spans x 0..32 voxels of the unrotated (north) bench, so the second block
		// sits on the model's +X side, which the shape's rotateY turns to east/south/west/north. Vanilla fills
		// it with an invisible multiblock-monolithic placeholder that forwards clicks, breaking and hitboxes.
		{ name: "Multiblock", propertiesByType: {
			"*-north": { sizex: 2, sizey: 1, sizez: 1, cposition: { x: 0, y: 0, z: 0 } },
			"*-east": { sizex: 1, sizey: 1, sizez: 2, cposition: { x: 0, y: 0, z: 0 } },
			"*-south": { sizex: 2, sizey: 1, sizez: 1, cposition: { x: 1, y: 0, z: 0 } },
			"*-west": { sizex: 1, sizey: 1, sizez: 2, cposition: { x: 0, y: 0, z: 1 } }
		} }
	],
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	attributes: {
		// Where the blueprint and the installed ingredients render is set by marker cubes in the shape, moved in
		// VS Model Creator (see WorkbenchSocketMarkers): SocketBlueprint, then Socket1..Socket8. An item is
		// centered on its marker's bottom face, sits on it, and turns with the marker's Y rotation.
		// SocketBlueprint must stay at the center of the BlueprintToolRail cube: the blueprint item's
		// onJonasWorkbenchTransform hangs the sheet from it by its top edge.
		// Sockets are filled in number order, one per ingredient across all of a recipe's stages (up to 8), and
		// are numbered in mirrored pairs so any recipe size fills the bench symmetrically: back row beside the
		// blueprint, then the front row. socketScale 0.4 makes a full-block item about 6 voxels across, the size
		// of the marker pads.
		workbench: {
			blueprintScale: 0.8,
			socketScale: 0.4
		}
	},
	creativeinventory: { "general": ["*-north"], "decorative": ["*-north"] },
	shape: {
		base: "block/jonasworkbench",
		// Socket markers: positions only, never rendered.
		ignoreElements: ["SocketBlueprint", "Socket1", "Socket2", "Socket3", "Socket4", "Socket5", "Socket6", "Socket7", "Socket8"],
		rotateYByType: { "*-north": 0, "*-east": 270, "*-south": 180, "*-west": 90 }
	},
	blockmaterial: "Wood",
	sidesolid: { all: false },
	sideopaque: { all: false },
	lightAbsorption: 0,
	resistance: 3,
	collisionSelectionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.875, z2: 1 },
	drops: [
		{ type: "block", code: "jonasworkbench-north" }
	],
	sounds: {
		"hit": "game:block/planks",
		"break": "game:block/planks",
		"place": "game:block/planks",
		"walk": "game:walk/wood"
	},
	combustibleProps: {
		burnTemperature: 600,
		burnDuration: 25
	},
	materialDensity: 600,
	// Centered on the two-block model (x 0..2).
	guiTransform: {
		origin: { x: 1, y: 0.5, z: 0.5 },
		scale: 0.8
	}
}
