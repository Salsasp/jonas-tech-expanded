{
	code: "jonasblueprint",
	variantgroups: [
		// Part blueprints use the vanilla part's own type state, so the grid recipe maps jonasparts-{type} and
		// jonasframes-{type} straight onto jonasblueprint-{type}. The two vanilla groups share no state names.
		{ code: "type", states: [
			"springboots", "exoskeleton",
			"connector01", "cylinder01", "cylinder02", "tank01", "tank02", "valve01",
			"gearbox01", "gearbox02", "oscillator01", "spring01", "joint01", "gears01", "gears02"
		] }
	],
	maxstacksize: 1,
	attributes: {
		// On the workbench, hang the sheet from its top edge: moves the sheet's top-edge pivot
		// (voxels 8, 14.2, 0.9) onto the socket point, nudged 0.35 voxels forward (after the bench's 0.8
		// scale) so it hangs in front of the blueprint rail. Turned 180 degrees about that pivot so the sheet's
		// tilt swings it away from the bench instead of into it. The engine merges this into every variant's
		// attributesByType entry below.
		onJonasWorkbenchTransform: {
			translation: { x: 0, y: -0.8875, z: 0.4711 },
			origin: { x: 0.5, y: 0.8875, z: 0.05625 },
			rotation: { x: 0, y: 180, z: 0 }
		}
	},
	attributesByType: {
		// Recipe for the Jonas workbench. Stages use vanilla's right-click construction format (the same as
		// the waterwheel): each stage's requireStacks are taken from the hotbar in one right-click. Unprefixed
		// codes are in this mod's domain. After the last stage, hold right-click for assemblySeconds.
		"*-springboots": {
			jonasWorkbench: {
				output: { type: "item", code: "springboots" },
				assemblySeconds: 4,
				stages: [
					{ requireStacks: [ { type: "item", code: "shockabsorptionapparatus", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "shockabsorptionapparatus", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "springbootsbody", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "springbootsbody", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "game:jonasframes-gears02", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "game:jonasparts-cylinder01", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "game:metalnailsandstrips-steel", quantity: 8 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "game:flaxtwine", quantity: 8 } ], actionLangCode: "jonastechexpanded:workbench-install" }
				]
			}
		},
		"*-exoskeleton": {
			jonasWorkbench: {
				output: { type: "item", code: "exoskeletonchest" },
				assemblySeconds: 4,
				stages: [
					{ requireStacks: [ { type: "item", code: "game:armor-body-jerkin-leather", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "exoskeletontorsoframe", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "exoskeletonarmframe", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "exoskeletonarmframe", quantity: 1 } ], actionLangCode: "jonastechexpanded:workbench-install" },
					{ requireStacks: [ { type: "item", code: "game:metalnailsandstrips-steel", quantity: 8 } ], actionLangCode: "jonastechexpanded:workbench-install" }
				]
			}
		},
		// Part blueprints: every part takes 1 steel ingot, 1 cupronickel ingot and 2 steel nails and strips,
		// plus extras that suit the part. Copied from a found part plus parchment in the crafting grid
		// (recipes/grid/jonas/jonasblueprint.json).
