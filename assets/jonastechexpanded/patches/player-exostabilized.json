[
	// Appended after survival's own temporalStabilityAffected patch, so this behavior ticks after it and
	// can undo its stability drain within the same tick.
	{
		"op": "add",
		"path": "/client/behaviors/-",
		"value": { code: "exoStabilized" },
		"file": "game:entities/humanoid/player.json",
		"condition": { "when": "temporalStability", "isValue": "true" },
		"side": "Server"
	},
	{
		"op": "add",
		"path": "/server/behaviors/-",
		"value": { code: "exoStabilized" },
		"file": "game:entities/humanoid/player.json",
		"condition": { "when": "temporalStability", "isValue": "true" },
		"side": "Server"
	}
]
